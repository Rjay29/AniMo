# AniMo local settings
# Copy this file to .env (same folder as server.js) and fill in your own values.
# .env is listed in .gitignore. Never commit it or share your API key.

# Google Gemini API key for the AI assistant (get one at https://aistudio.google.com/apikey).
# Leave empty to use the built-in AniMo answers only.
GEMINI_API_KEY=

# Optional: Gemini model name. Default: gemini-3.5-flash-lite
GEMINI_MODEL=

# Administrator account, created the FIRST time the server starts with these set.
# Changing the password here later does not change an existing admin's password.
ANIMO_ADMIN_USERNAME=
ANIMO_ADMIN_PASSWORD=

# Optional: server port (default 8000, always bound to 127.0.0.1).
PORT=
